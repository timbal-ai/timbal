ANTHROPIC_API_KEY=your_anthropic_api_key

# Your Qlik Cloud tenant, e.g. https://your-tenant.eu.qlikcloud.com
QLIK_TENANT_URL=https://your-tenant.eu.qlikcloud.com

# The OAuth client from Administration > OAuth (both modes use it)
QLIK_CLIENT_ID=your_oauth_client_id
QLIK_CLIENT_SECRET=your_oauth_client_secret

# "personal" (act as a signed-in person) or "service" (act as the OAuth client)
QLIK_AUTH_MODE=service

# Personal mode only: `python setup_credentials.py` signs you in and writes this file.
# The tools keep the newest refresh token in it (Qlik can rotate them on each use).
QLIK_TOKEN_FILE=.qlik_token.json
