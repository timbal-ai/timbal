ANTHROPIC_API_KEY=your_anthropic_api_key

# Method 2 - API key (internal integration): the "Internal Integration Secret"
NOTION_API_KEY=

# Method 1 - OAuth (public integration): the integration's OAuth client
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Written by `python setup_credentials.py`; the tools keep the newest refresh token in it
NOTION_TOKEN_FILE=.notion_token.json

# Optional: "oauth" or "api_key" to pin one method (unset: OAuth first, then the API key)
NOTION_AUTH_METHOD=
